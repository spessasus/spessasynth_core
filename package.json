{
    "name": "spessasynth_core",
    "version": "4.4.12",
    "description": "MIDI and SoundFont2/DLS library with no compromises",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "npm run check && npm run build:fast",
        "build:fast": "rimraf dist && tsdown src/index.ts --tsconfig src/tsconfig.json --platform neutral --sourcemap",
        "check": "npm run lint && node node_modules/typescript7/bin/tsc -b",
        "deps:local": "npm uninstall stb-vorbis; npm install ../stb-vorbis",
        "deps:npm": "npm uninstall stb-vorbis; npm install stb-vorbis",
        "docs": "tsx node_modules/typedoc/bin/typedoc src/index.ts --options typedoc.json",
        "docs:serve": "concurrently \"npm run docs:watch\" \"npx serve site/\"",
        "docs:watch": "tsx node_modules/typedoc/bin/typedoc src/index.ts --options typedoc.json --watch",
        "format": "prettier --list-different --write .",
        "format:check": "prettier --check .",
        "lint": "eslint",
        "prepare": "husky",
        "prepublishOnly": "node -e \"const l=Object.entries(require('./package.json').dependencies).filter(([,v])=>/^(file|link):/.test(v));if(l.length){console.error('Linked locally: '+l.map(([k])=>k).join(', ')+'. Run npm run deps:npm before publishing.');process.exit(1)}\" && npm run format:check && npm run build",
        "test": "echo \"Error: no test specified\" && exit 1",
        "test:midi:build-renderer": "tsx tests/midi_file/renderer/build.ts",
        "test:midi:clean": "tsx tests/midi_file/clean.ts",
        "test:midi:generate": "tsx tests/midi_file/generate_midi.ts",
        "test:midi:render": "tsx tests/midi_file/render_audio.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/spessasus/spessasynth_core.git"
    },
    "keywords": [
        "soundfont",
        "synthesizer",
        "synth",
        "sf2",
        "sf3",
        "dls",
        "dls-to-sf2",
        "midi",
        "rmi",
        "midi-player",
        "midi-file",
        "midi-editor",
        "player",
        "soundfont2",
        "soundfont3",
        "audio-to-wav"
    ],
    "author": {
        "name": "spessasus",
        "email": "spesekspesek@gmail.com",
        "url": "https://github.com/spessasus"
    },
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/spessasus/spessasynth_core/issues",
        "email": "spesekspesek@gmail.com"
    },
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "package.json"
    ],
    "homepage": "https://github.com/spessasus/spessasynth_core#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@julusian/midi": "^3.9.0",
        "@types/markdown-it": "14.2.0",
        "@types/midi": "^2.0.4",
        "@types/node": "^26.6.6",
        "concurrently": "^10.0.7",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unicorn": "^80.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "prettier": "^3.10.1",
        "rimraf": "^6.1.3",
        "tsdown": "^0.23.7",
        "tsx": "^4.22.3",
        "typedoc": "0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "typescript7": "npm:typescript@^7.0.2"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "*.{json,md,yml,yaml}": "prettier --write"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "@julusian/midi@3.9.0": true
    },
    "dependencies": {
        "fflate": "0.8.3",
        "stb-vorbis": "^0.0.7"
    }
}
